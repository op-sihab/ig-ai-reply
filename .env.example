# ---------------------------------------------------------------------------
# Instagram AI auto-reply bot — copy this file to `.env` and fill it in.
# NEVER commit the real .env (it holds your tokens).
# ---------------------------------------------------------------------------

# --- Safety switch -----------------------------------------------------------
# true  = never calls Instagram; prints/stores the reply it WOULD have sent.
#         Keep this true until you have seen the bot answer correctly.
# false = really sends DMs.
DRY_RUN=true

# --- Meta / Instagram --------------------------------------------------------
# Verify token: any random string you invent. Paste the SAME value into the
# Meta app dashboard's webhook "Verify token" box.
IG_VERIFY_TOKEN=change-me-to-a-random-string

# App Secret: Meta app dashboard -> App settings -> Basic -> App secret.
# Used to verify every webhook really came from Meta. Leave empty ONLY for a
# throwaway local test (signature checking is then skipped).
IG_APP_SECRET=

# Long-lived Instagram user access token (60 days, refresh at day ~50).
IG_ACCESS_TOKEN=

# Your IG professional account id. "me" works when the token belongs to it.
IG_USER_ID=me

# Instagram Login path (no Facebook Page needed):
IG_HOST=https://graph.instagram.com
IG_API_VERSION=v25.0

# --- Behaviour ---------------------------------------------------------------
BIND=127.0.0.1
PORT=8080

# Wait this long after a person's LAST message before replying, so several
# quick messages get one good answer instead of three dumb ones.
DEBOUNCE_SECONDS=3.0

# How much of the conversation to give the model as context.
HISTORY_TURNS=12

# Hard cap on an outgoing DM, in characters.
REPLY_MAX_CHARS=900

# Show "typing…" and mark the thread seen before answering (feels human).
IG_TYPING=true

# Comma-separated words that should NOT be auto-answered at all: the bot stays
# silent and logs the thread to the handoff table for you to answer yourself.
# Example: HANDOFF_KEYWORDS=refund,complain,lawyer,police,scam
HANDOFF_KEYWORDS=

# What to do when the MODEL itself decides a human should take over:
#   auto = still send its reply — fully unattended (the default)
#   hold = send nothing, queue the thread for you instead
# A HANDOFF_KEYWORDS hit always holds, whatever this is set to.
HANDOFF_MODE=auto

# --- LLM (your existing merge.dev gateway) -----------------------------------
LLM_BASE_URL=https://api-gateway.merge.dev/v1
# Leave empty to fall back to HERMES_CUSTOM_MERGE_GATWAY_API_KEY from the env.
LLM_API_KEY=
LLM_MODEL=google/gemini-3.7-flash
LLM_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
# These are reasoning models: too small a budget returns empty content
# (finish_reason=length) because the thinking tokens eat it. Keep >= 600.
LLM_MAX_TOKENS=900
LLM_TIMEOUT=60

# --- Files -------------------------------------------------------------------
DB_PATH=data/state.db
PERSONA_FILE=persona.md
KNOWLEDGE_FILE=knowledge.md
LOG_LEVEL=info
